export function getStagePlayLimitStatus(state, stageId, now = Date.now()) {
  if (isStagePlayLimitDisabled(stageId)) {
    return {
      isActive: false,
      isLimited: false,
      playCount: 0,
      remainingPlays: STAGE_PLAY_LIMIT,
      remainingMs: 0,
      windowStartedAt: null
    };
  }
  const window2 = state.stagePlayLimits[stageId];
  if (!isActiveStagePlayWindow(window2, now)) {
    return {
      isActive: false,
      isLimited: false,
      playCount: 0,
      remainingPlays: STAGE_PLAY_LIMIT,
      remainingMs: STAGE_PLAY_WINDOW_MS,
      windowStartedAt: null
    };
  }
  const playCount = Math.min(STAGE_PLAY_LIMIT, Math.max(0, Math.floor(window2.playCount)));
  const remainingMs = Math.max(0, STAGE_PLAY_WINDOW_MS - (now - window2.startedAt));
  return {
    isActive: true,
    isLimited: playCount >= STAGE_PLAY_LIMIT && remainingMs > 0,
    playCount,
    remainingPlays: Math.max(0, STAGE_PLAY_LIMIT - playCount),
    remainingMs,
    windowStartedAt: window2.startedAt
  };
}
export function recordStagePlayEntry(stageId, now = Date.now()) {
  if (!knownStageIds.has(stageId)) {
    return null;
  }
  const current = loadSaveState();
  const status = getStagePlayLimitStatus(current, stageId, now);
  if (status.isLimited) {
    return null;
  }
  if (isStagePlayLimitDisabled(stageId)) {
    const nextStagePlayLimits2 = normalizeStagePlayLimitRecord(current.stagePlayLimits, now);
    delete nextStagePlayLimits2[stageId];
    const next2 = incrementDailyMissionCounter({
      ...current,
      stagePlayLimits: nextStagePlayLimits2
    }, "stageEntries", 1, now);
    if (!saveState(next2)) {
      return null;
    }
    return next2;
  }
  const currentWindow = current.stagePlayLimits[stageId];
  const startedAt = isActiveStagePlayWindow(currentWindow, now) ? currentWindow.startedAt : now;
  const nextStagePlayLimits = normalizeStagePlayLimitRecord(current.stagePlayLimits, now);
  nextStagePlayLimits[stageId] = {
    startedAt,
    playCount: status.playCount + 1
  };
  const next = incrementDailyMissionCounter({
    ...current,
    stagePlayLimits: nextStagePlayLimits
  }, "stageEntries", 1, now);
  if (!saveState(next)) {
    return null;
  }
  return next;
}
export function recordStagePlayEntryUsingItem(stageId, itemId, count = 1, now = Date.now()) {
  const normalizedCount = normalizePositiveInteger(count);
  if (!knownStageIds.has(stageId) || !knownShopItemIds.has(itemId) || normalizedCount === null) {
    return null;
  }
  const current = loadSaveState();
  const currentItemCount = current.items[itemId] ?? 0;
  const status = getStagePlayLimitStatus(current, stageId, now);
  if (status.isLimited || currentItemCount < normalizedCount) {
    return null;
  }
  const currentWindow = current.stagePlayLimits[stageId];
  const startedAt = isActiveStagePlayWindow(currentWindow, now) ? currentWindow.startedAt : now;
  const nextStagePlayLimits = normalizeStagePlayLimitRecord(current.stagePlayLimits, now);
  delete nextStagePlayLimits[stageId];
  if (!isStagePlayLimitDisabled(stageId)) {
    nextStagePlayLimits[stageId] = {
      startedAt,
      playCount: status.playCount + 1
    };
  }
  const nextItems = {
    ...current.items,
    [itemId]: currentItemCount - normalizedCount
  };
  if (nextItems[itemId] <= 0) {
    delete nextItems[itemId];
  }
  const next = incrementDailyMissionCounter({
    ...current,
    items: nextItems,
    stagePlayLimits: nextStagePlayLimits
  }, "stageEntries", 1, now);
  if (!saveState(next)) {
    return null;
  }
  return next;
}
