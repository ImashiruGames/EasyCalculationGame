  const nextItems = { ...current.items };
  if (status.rewardItemId && status.rewardItemCount > 0) {
    nextItems[status.rewardItemId] = (nextItems[status.rewardItemId] ?? 0) + status.rewardItemCount;
  }
  const next = {
    ...current,
    coins: current.coins + status.rewardCoins,
    items: nextItems,
    dailyLogin: {
